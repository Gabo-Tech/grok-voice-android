<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9A9690"
    android:orientation="vertical"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0F11"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_brand"
            android:textColor="#EEECE8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_listen_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_listen_off"
            android:textColor="#8B8A86"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#EEECE8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_listen_toggle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#C4B5A0"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/widget_listen_start"
                android:textColor="#1A1B1E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_listen_now"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#17181B"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/widget_listen_now"
                android:textColor="#EEECE8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
