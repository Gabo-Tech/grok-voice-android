<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grok"
        android:textColor="#F5F5F5"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_listen_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Background listening is off"
        android:textColor="#A3A3A3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#F5F5F5"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_listen_toggle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:text="Listen in background"
            android:textColor="#0E0E0E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_listen_now"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_outline"
            android:gravity="center"
            android:text="Listen now"
            android:textColor="#F5F5F5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
